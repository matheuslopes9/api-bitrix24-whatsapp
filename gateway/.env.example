# ─────────────────────────────────────────────────────────────────────────
# Gateway Itaú — PIX + Boleto. Copie para .env e preencha.
# NUNCA versione o .env preenchido nem os certificados (.crt/.key).
# ─────────────────────────────────────────────────────────────────────────

# ── Autenticação (token / segredo / identidade) ──────────────────────────
# O Client ID É TAMBÉM o CN do certificado — os dois têm que bater.
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
# x-itau-apikey. Se vazio, o gateway usa o próprio Client ID.
ITAU_API_KEY=

# ── Certificado mTLS ─────────────────────────────────────────────────────
# Par .crt/.key da empresa. Obrigatório em produção. Montar no volume.
ITAU_CERT_PATH=/app/certs/itau.crt
ITAU_KEY_PATH=/app/certs/itau.key

# ── Ambiente / endpoints ─────────────────────────────────────────────────
ITAU_ENV=sandbox
# Overrides opcionais (deixe vazio pra usar os defaults de produção):
ITAU_BASE_URL=
ITAU_TOKEN_URL=
ITAU_BOLETO_URL=

# ── PIX ──────────────────────────────────────────────────────────────────
# Chave PIX que recebe os pagamentos (CNPJ, e-mail, telefone ou aleatória).
ITAU_CHAVE_PIX=

# ── Boleto (dados da conta beneficiária) ─────────────────────────────────
ITAU_AGENCIA=
ITAU_CONTA=
ITAU_CONTA_DAC=
ITAU_CARTEIRA=109
ITAU_ESPECIE=08
# validacao = teste (não emite título real) | efetivacao = real
ITAU_ETAPA=efetivacao

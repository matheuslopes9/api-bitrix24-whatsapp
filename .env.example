# ─── Servidor ───────────────────────────────────────────────────────────────
APP_PORT=3000
APP_ENV=production
APP_SECRET=troque_por_secret_forte_aqui
# URL publica do app — usada para montar redirect_uri e links dos e-mails.
APP_BASE_URL=https://seuservidor.com/

# ─── Painel super-admin ──────────────────────────────────────────────────────
# Login para /admin (visão de TODOS os portais Bitrix24 que instalaram o app).
# Se vazio, /admin retorna 503.
ADMIN_USER=admin
ADMIN_PASSWORD=troque_por_senha_forte

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp_secret
POSTGRES_DB=whatsapp_bitrix
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=50
POSTGRES_MAX_IDLE_CONNS=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WA_SESSIONS_DIR=./sessions
WA_MEDIA_DIR=./media
WA_LOG_LEVEL=INFO

# ─── Bitrix24 ────────────────────────────────────────────────────────────────
BITRIX_DOMAIN=https://suaempresa.bitrix24.com.br
BITRIX_CLIENT_ID=seu_client_id
BITRIX_CLIENT_SECRET=seu_client_secret
BITRIX_REDIRECT_URI=https://seuservidor.com/bitrix/callback

# ─── Fila ────────────────────────────────────────────────────────────────────
QUEUE_WORKERS=20
QUEUE_MAX_RETRY=5
QUEUE_RETRY_BASE_DELAY_MS=1000

# ─── Watchdog ────────────────────────────────────────────────────────────────
WATCHDOG_PING_INTERVAL_SECS=30

# ─── Alertas por e-mail ──────────────────────────────────────────────────────
# O app NAO fala com a Microsoft: ele manda SMTP simples pro proxy OAuth2 da
# empresa (tools/oauth2-email-service), e o proxy resolve o XOAUTH2. Nenhuma
# credencial do Azure entra aqui.
#
# Em container, SMTP_HOST e' o NOME DO SERVICO do proxy — 127.0.0.1 seria o
# proprio container do app, onde o proxy nao esta rodando.
SMTP_HOST=uctalk-email
SMTP_PORT=2525
# Endereco que aparece no From: dos alertas.
EMAIL_SENDER=noreply@suaempresa.com.br
EMAIL_REPLY_TO=suporte@suaempresa.com.br
# Quem recebe os alertas (token vencido, numero caido, licenca vencendo).
# Separe por virgula. VAZIO = alertas desligados, e o log avisa isso no boot.
ALERT_RECIPIENTS=suporte@suaempresa.com.br,financeiro@suaempresa.com.br
